<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="ShellReselectRepro.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:ShellReselectRepro.Pages">

  <TabBar>
    <ShellContent Title="Home"
                  ContentTemplate="{DataTemplate pages:HomePage}"
                  Route="HomePage" />

    <ShellContent Title="Other"
                  ContentTemplate="{DataTemplate pages:OtherPage}"
                  Route="OtherPage" />
  </TabBar>

</Shell>
